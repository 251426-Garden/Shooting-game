<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>카카오맵 장소 검색 서비스</title>
    <style>
        /* 기본 스타일 초기화 */
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            font-family: 'Malgun Gothic', sans-serif;
        }

        /* 화면을 왼쪽(검색창)과 오른쪽(지도)으로 나누는 컨테이너 */
        .container {
            display: flex;
            width: 100%;
            height: 100%;
        }

        /* 왼쪽 검색창 사이드바 스타일 */
        .sidebar {
            width: 350px;
            height: 100%;
            background-color: #ffffff;
            box-shadow: 3px 0 10px rgba(0, 0, 0, 0.1);
            z-index: 10;
            padding: 20px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        .sidebar h2 {
            font-size: 20px;
            margin-bottom: 15px;
            color: #333;
        }

        /* 검색 입력창과 버튼을 감싸는 폼 */
        #searchForm {
            display: flex;
            margin-bottom: 20px;
        }

        #keyword {
            flex: 1;
            padding: 10px;
            font-size: 14px;
            border: 1px solid #ddd;
            border-radius: 4px 0 0 4px;
            outline: none;
        }

        #searchForm button {
            padding: 10px 15px;
            font-size: 14px;
            background-color: #fee500; /* 카카오 시그니처 노란색 */
            border: 1px solid #fee500;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            font-weight: bold;
        }

        #searchForm button:hover {
            background-color: #fada0a;
        }

        /* 검색 결과 목록 스타일 */
        #placesList {
            list-style: none;
            padding: 0;
            margin: 0;
            overflow-y: auto; /* 결과가 많으면 스크롤 생성 */
            flex: 1;
        }

        #placesList li {
            padding: 15px 10px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        #placesList li:hover {
            background-color: #f9f9f9;
        }

        #placesList li strong {
            display: block;
            font-size: 15px;
            color: #007bff;
        }

        #placesList li small {
            color: #666;
            font-size: 12px;
        }

        /* 오른쪽 지도 영역 스타일 */
        #map {
            flex: 1;
            height: 100%;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="sidebar">
            <h2>어디로 가고 싶으신가요?</h2>
            <form id="searchForm">
                <input type="text" id="keyword" placeholder="장소를 입력하세요 (예: 강남역)" required>
                <button type="submit">검색</button>
            </form>
            <ul id="placesList"></ul>
        </div>

        <div id="map"></div>
    </div>

    <script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=e429e338d7d530fd3adfdfb87281d983&libraries=services"></script>
    
    <script>
        // 전역 변수 설정
        const mapContainer = document.getElementById('map'); // 지도를 표시할 div
        let map; // 지도 객체
        let placeService; // 장소 검색 서비스 객체
        let markers = []; // 지도에 표시된 마커들을 저장할 배열

        // 페이지와 카카오 스크립트가 모두 로드된 후 실행되도록 설정
        window.onload = function() {
            // 브라우저가 위치 권한(Geolocation)을 지원하는지 확인
            if (navigator.geolocation) {
                // 현재 위치 가져오기 요청
                navigator.geolocation.getCurrentPosition(function(position) {
                    const lat = position.coords.latitude;  // 위도
                    const lon = position.coords.longitude; // 경도
                    
                    const currentPos = new kakao.maps.LatLng(lat, lon);
                    initMap(currentPos); // 현재 위치를 중심으로 지도 초기화
                }, function(error) {
                    // 권한 거부 등의 이유로 위치를 못 가져올 때 기본 위치(서울시청) 사용
                    console.error("위치 정보를 가져오지 못했습니다.", error);
                    const defaultPos = new kakao.maps.LatLng(37.566826, 126.9786567);
                    initMap(defaultPos);
                });
            } else {
                // Geolocation을 지원하지 않는 브라우저일 때 기본 위치 사용
                const defaultPos = new kakao.maps.LatLng(37.566826, 126.9786567);
                initMap(defaultPos);
            }
        };

        // 지도를 생성하고 이벤트를 연결하는 함수
        function initMap(centerPosition) {
            const mapOptions = {
                center: centerPosition, // 지도의 중심좌표
                level: 5 // 지도의 확대 레벨 (요청하신 레벨 5)
            };

            // 지도 생성
            map = new kakao.maps.Map(mapContainer, mapOptions);
            
            // 장소 검색 객체 생성
            placeService = new kakao.maps.services.Places();

            // 현재 위치에 기본 마커 하나 표시
            new kakao.maps.Marker({
                position: centerPosition,
                map: map
            });
            
            // 검색 버튼 클릭 및 엔터 키 입력 시 이벤트 처리
            const searchForm = document.getElementById('searchForm');
            searchForm.addEventListener('submit', function(e) {
                e.preventDefault(); // 폼 제출 시 페이지 새로고침 방지
                
                const keyword = document.getElementById('keyword').value;
                if (!keyword.trim()) {
                    alert('검색어를 입력해주세요!');
                    return;
                }
                
                // 카카오 API를 이용해 키워드로 장소 검색 실행
                placeService.keywordSearch(keyword, placesSearchCallback);
            });
        }

        // 장소검색이 완료됐을 때 호출되는 콜백 함수
        function placesSearchCallback(data, status, pagination) {
            if (status === kakao.maps.services.Status.OK) {
                // 정상적으로 검색이 완료되면 목록과 마커를 화면에 표시
                displayPlaces(data);
            } else if (status === kakao.maps.services.Status.ZERO_RESULT) {
                alert('검색 결과가 존재하지 않습니다.');
            } else if (status === kakao.maps.services.Status.ERROR) {
                alert('검색 결과 중 오류가 발생했습니다.');
            }
        }

        // 검색 결과 목록과 마커를 표출하는 함수
        function displayPlaces(places) {
            const listEl = document.getElementById('placesList');
            const bounds = new kakao.maps.LatLngBounds(); // 지도 범위를 재설정할 객체
            
            // 이전 검색 결과 및 마커 지우기
            removeMarkers();
            listEl.innerHTML = '';

            for (let i = 0; i < places.length; i++) {
                // 검색된 장소의 좌표 생성
                const placePosition = new kakao.maps.LatLng(places[i].y, places[i].x);
                
                // 지도에 마커 추가
                const marker = addMarker(placePosition);
                
                // 검색된 모든 장소가 보이도록 지도 범위를 확장하기 위해 좌표 추가
                bounds.extend(placePosition);

                // 왼쪽에 표시할 리스트 아이템 생성
                const itemEl = document.createElement('li');
                itemEl.innerHTML = `<strong>${places[i].place_name}</strong>
                                    <small>${places[i].road_address_name || places[i].address_name}</small>`;
                
                // 리스트 아이템을 클릭하면 해당 장소로 부드럽게 지도 이동
                itemEl.addEventListener('click', function() {
                    map.panTo(placePosition);
                });

                listEl.appendChild(itemEl);
            }

            // 검색된 장소들을 한눈에 볼 수 있도록 지도 중심과 확대 레벨을 자동으로 맞춤
            map.setBounds(bounds);
        }

        // 지도 위에 마커를 생성하고 배열에 저장하는 함수
        function addMarker(position) {
            const marker = new kakao.maps.Marker({
                position: position,
                map: map
            });
            markers.push(marker); // 생성된 마커를 배열에 넣어 나중에 지울 수 있도록 함
            return marker;
        }

        // 기존에 지도에 있던 마커들을 모두 지우는 함수
        function removeMarkers() {
            for (let i = 0; i < markers.length; i++) {
                markers[i].setMap(null);
            }
            markers = []; // 배열 초기화
        }
    </script>
</body>
</html>
